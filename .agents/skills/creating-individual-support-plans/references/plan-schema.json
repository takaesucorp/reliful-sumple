{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "個別支援計画書入力データ",
  "type": "object",
  "required": ["metadata", "wishes", "goals", "weekly_schedule", "support_items", "notes", "agreement", "facility"],
  "properties": {
    "metadata": {
      "type": "object",
      "description": "計画書の基本情報。押印はWord出力後に行うためデータ化しない。",
      "required": ["target_year", "target_month", "user_name", "created_date", "previous_created_date", "author", "manager_approval", "service_manager_approval"],
      "properties": {
        "target_year": {"type": "string", "description": "対象年。元号を含む表示文字列"},
        "target_month": {"type": "string", "description": "対象月"},
        "user_name": {"type": "string", "description": "利用者氏名"},
        "created_date": {"type": "string", "description": "作成日"},
        "previous_created_date": {"type": "string", "description": "前回作成日。初回等の場合は確認済みの表現"},
        "author": {"type": "string", "description": "計画作成者"},
        "manager_approval": {"type": "string", "description": "管理者確認欄。未押印は空文字"},
        "service_manager_approval": {"type": "string", "description": "サービス管理責任者確認欄。未押印は空文字"}
      },
      "additionalProperties": false
    },
    "wishes": {
      "type": "object",
      "required": ["person", "family"],
      "properties": {
        "person": {"type": "string", "description": "本人の要望"},
        "family": {"type": "string", "description": "家族の要望。該当しない場合は確認済みの表現または空文字"}
      },
      "additionalProperties": false
    },
    "goals": {
      "type": "object",
      "required": ["long_term", "short_term"],
      "properties": {
        "long_term": {"$ref": "#/$defs/datedGoal"},
        "short_term": {"$ref": "#/$defs/datedGoal"}
      },
      "additionalProperties": false
    },
    "weekly_schedule": {
      "type": "object",
      "required": ["legend", "rows"],
      "properties": {
        "legend": {"type": "string", "description": "活動番号などの凡例"},
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["label", "monday", "tuesday", "wednesday", "thursday", "friday", "saturday"],
            "properties": {
              "label": {"type": "string", "description": "時間帯または区分"},
              "monday": {"type": "string"},
              "tuesday": {"type": "string"},
              "wednesday": {"type": "string"},
              "thursday": {"type": "string"},
              "friday": {"type": "string"},
              "saturday": {"type": "string"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "support_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["domains", "goal", "start_date", "end_date", "support_details", "assigned_roles"],
        "properties": {
          "domains": {"type": "array", "items": {"type": "string"}, "description": "本人の要望・支援分野に対応する区分"},
          "goal": {"type": "string", "description": "具体的な課題または到達目標"},
          "start_date": {"type": "string"},
          "end_date": {"type": "string"},
          "support_details": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "assigned_roles": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "notes": {"type": "string", "description": "備考"},
    "agreement": {
      "type": "object",
      "required": ["explanation_date", "person_name", "family_name", "consent_date", "service_confirmation_date", "service_confirmation_name"],
      "properties": {
        "explanation_date": {"type": "string"},
        "person_name": {"type": "string", "description": "本人署名欄。未署名は空文字"},
        "family_name": {"type": "string", "description": "家族署名欄。未署名または該当なしは空文字"},
        "consent_date": {"type": "string"},
        "service_confirmation_date": {"type": "string"},
        "service_confirmation_name": {"type": "string", "description": "相談支援事業所等の確認先。未確認は空文字"}
      },
      "additionalProperties": false
    },
    "facility": {
      "type": "object",
      "required": ["service_type", "name", "postal_code", "address", "business_number", "phone", "fax", "manager", "explainer"],
      "properties": {
        "service_type": {"type": "string"},
        "name": {"type": "string"},
        "postal_code": {"type": "string"},
        "address": {"type": "string"},
        "business_number": {"type": "string"},
        "phone": {"type": "string"},
        "fax": {"type": "string"},
        "manager": {"type": "string"},
        "explainer": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "datedGoal": {
      "type": "object",
      "required": ["text", "start_date", "end_date"],
      "properties": {
        "text": {"type": "string"},
        "start_date": {"type": "string"},
        "end_date": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

